import { useState } from 'react';
import { Link, Head, router } from '@inertiajs/react';
import FrontendLayout from '@/Layouts/FrontendLayout';

export default function UserDashboard({ user, bookings = [], history = [] }) {
    const [activeTab, setActiveTab] = useState('info');
    const [bookingStatus, setBookingStatus] = useState('menunggu');

    const handleLogout = () => {
        router.post(route('logout'));
    };

    const filteredBookings = bookings.filter((b) => b.status === bookingStatus);

    const tabNavItems = [
        {
            key: 'info',
            label: 'Informasi Akun',
            icon: (
                <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2"
                        d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
            ),
        },
        {
            key: 'bookings',
            label: 'Pesanan Saya',
            icon: (
                <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2"
                        d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                </svg>
            ),
        },
        {
            key: 'history',
            label: 'Riwayat Sewa',
            icon: (
                <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2"
                        d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                </svg>
            ),
        },
    ];

    const formatDate = (dateStr) => {
        if (!dateStr) return '-';
        return new Date(dateStr).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
    };

    return (
        <FrontendLayout title="Akun Saya | Petahunan Rent Car">
            <Head title="Akun Saya | Petahunan Rent Car" />

            <div className="bg-slate-50 min-h-screen py-8">
                <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row gap-8">

                    {/* Sidebar */}
                    <div className="w-full md:w-1/4 shrink-0">
                        <div className="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden sticky top-24">
                            {/* Avatar */}
                            <div className="p-6 border-b border-slate-100 flex items-center gap-4">
                                <div className="w-12 h-12 rounded-full bg-blue-600/10 text-blue-600 flex items-center justify-center font-bold text-xl uppercase">
                                    {user?.name?.charAt(0) ?? 'U'}
                                </div>
                                <div>
                                    <h3 className="font-bold text-slate-800">{user?.name}</h3>
                                    <p className="text-xs text-slate-500 capitalize">{user?.role ?? 'Penyewa'}</p>
                                </div>
                            </div>

                            {/* Nav */}
                            <nav className="p-3 space-y-1">
                                {tabNavItems.map((item) => (
                                    <button
                                        key={item.key}
                                        onClick={() => setActiveTab(item.key)}
                                        className={`w-full flex items-center gap-3 px-4 py-3 text-sm font-medium rounded-xl transition-colors ${
                                            activeTab === item.key
                                                ? 'bg-blue-600 text-white shadow-md'
                                                : 'text-slate-600 hover:bg-slate-50'
                                        }`}
                                    >
                                        {item.icon}
                                        {item.label}
                                    </button>
                                ))}

                                <div className="pt-4 mt-2 border-t border-slate-100">
                                    <button
                                        onClick={handleLogout}
                                        className="w-full flex items-center gap-3 px-4 py-3 text-sm font-medium rounded-xl text-rose-600 hover:bg-rose-50 transition-colors"
                                    >
                                        <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2"
                                                d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                                        </svg>
                                        Keluar (Logout)
                                    </button>
                                </div>
                            </nav>
                        </div>
                    </div>

                    {/* Content Area */}
                    <div className="w-full md:w-3/4">

                        {/* TAB 1: Info Akun */}
                        {activeTab === 'info' && (
                            <div className="bg-white rounded-2xl shadow-sm border border-slate-200 p-8">
                                <h2 className="text-xl font-bold text-slate-800 mb-6 border-b pb-4">Informasi Pribadi</h2>
                                <div className="space-y-4">
                                    <div>
                                        <label className="block text-sm font-medium text-slate-500">Nama Lengkap</label>
                                        <p className="mt-1 font-semibold text-slate-900">{user?.name}</p>
                                    </div>
                                    <div>
                                        <label className="block text-sm font-medium text-slate-500">Alamat Email</label>
                                        <p className="mt-1 font-semibold text-slate-900">{user?.email}</p>
                                    </div>
                                    <div>
                                        <label className="block text-sm font-medium text-slate-500">Nomor Telepon</label>
                                        <p className="mt-1 font-semibold text-slate-900">{user?.no_telepon ?? '-'}</p>
                                    </div>
                                    <div>
                                        <label className="block text-sm font-medium text-slate-500">Bergabung Sejak</label>
                                        <p className="mt-1 font-semibold text-slate-900">{formatDate(user?.created_at)}</p>
                                    </div>
                                    <div className="pt-4">
                                        <button className="bg-slate-100 text-slate-700 px-4 py-2 rounded-lg text-sm font-medium hover:bg-slate-200 transition">
                                            Edit Profil
                                        </button>
                                    </div>
                                </div>
                            </div>
                        )}

                        {/* TAB 2: Pesanan */}
                        {activeTab === 'bookings' && (
                            <div className="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                                {/* Status Tabs */}
                                <div className="flex border-b border-slate-200 bg-slate-50 overflow-x-auto">
                                    {[
                                        { key: 'menunggu', label: 'Menunggu Pembayaran' },
                                        { key: 'dikonfirmasi', label: 'Terkonfirmasi' },
                                        { key: 'berjalan', label: 'Sedang Disewa' },
                                    ].map((s) => (
                                        <button
                                            key={s.key}
                                            onClick={() => setBookingStatus(s.key)}
                                            className={`flex-1 py-4 px-6 text-sm font-bold text-center border-b-2 transition-colors whitespace-nowrap ${
                                                bookingStatus === s.key
                                                    ? 'border-blue-600 text-blue-600 bg-white'
                                                    : 'border-transparent text-slate-500 hover:text-slate-700'
                                            }`}
                                        >
                                            {s.label}
                                        </button>
                                    ))}
                                </div>

                                {/* Bookings List */}
                                <div className="p-8">
                                    {filteredBookings.length === 0 ? (
                                        <div className="text-center text-slate-500">
                                            <svg className="w-16 h-16 mx-auto text-slate-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.5"
                                                    d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                                            </svg>
                                            <p className="font-medium text-slate-600">Belum ada pesanan di status ini.</p>
                                            <p className="text-sm mt-1">Cari mobil impian Anda dan mulai perjalanan sekarang!</p>
                                            <Link
                                                href={route('catalog')}
                                                className="inline-block mt-4 bg-blue-600 text-white px-6 py-2 rounded-lg text-sm font-bold hover:bg-blue-700 transition"
                                            >
                                                Eksplor Katalog
                                            </Link>
                                        </div>
                                    ) : (
                                        <div className="space-y-4">
                                            {filteredBookings.map((booking) => (
                                                <div key={booking.id} className="border border-slate-200 rounded-xl p-4 flex justify-between items-center">
                                                    <div>
                                                        <p className="font-bold text-slate-900">{booking.kendaraan?.merk}</p>
                                                        <p className="text-sm text-slate-500">{formatDate(booking.tanggal_sewa)} • {booking.durasi} hari</p>
                                                    </div>
                                                    <span className="bg-amber-100 text-amber-700 text-xs font-bold px-3 py-1 rounded-full capitalize">
                                                        {booking.status}
                                                    </span>
                                                </div>
                                            ))}
                                        </div>
                                    )}
                                </div>
                            </div>
                        )}

                        {/* TAB 3: Riwayat */}
                        {activeTab === 'history' && (
                            <div className="bg-white rounded-2xl shadow-sm border border-slate-200 p-8">
                                {history.length === 0 ? (
                                    <div className="text-center text-slate-500">
                                        <svg className="w-16 h-16 mx-auto text-slate-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.5"
                                                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                        </svg>
                                        <p className="font-medium text-slate-600">Belum ada riwayat perjalanan.</p>
                                        <p className="text-sm mt-1">Pesanan yang sudah selesai atau dibatalkan akan muncul di sini.</p>
                                    </div>
                                ) : (
                                    <div className="space-y-4">
                                        {history.map((item) => (
                                            <div key={item.id} className="border border-slate-200 rounded-xl p-4 flex justify-between items-center">
                                                <div>
                                                    <p className="font-bold text-slate-900">{item.kendaraan?.merk}</p>
                                                    <p className="text-sm text-slate-500">{formatDate(item.tanggal_sewa)} • {item.durasi} hari</p>
                                                </div>
                                                <span className={`text-xs font-bold px-3 py-1 rounded-full ${item.status === 'selesai' ? 'bg-emerald-100 text-emerald-700' : 'bg-rose-100 text-rose-700'}`}>
                                                    {item.status}
                                                </span>
                                            </div>
                                        ))}
                                    </div>
                                )}
                            </div>
                        )}

                    </div>
                </div>
            </div>
        </FrontendLayout>
    );
}
